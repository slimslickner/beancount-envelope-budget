option "operating_currency" "USD"

2020-01-01 open Assets:Checking USD
  cash-account: TRUE
2020-01-01 open Equity:Opening-Balances USD

2023-12-31 * "Opening balance"
  Assets:Checking            1000.00 USD
  Equity:Opening-Balances   -1000.00 USD

2024-01-01 custom "envelope" "start"
2024-01-01 custom "envelope" "open" "A"
2024-01-01 custom "envelope" "open" "B"
2024-01-01 custom "envelope" "open" "C"

2024-01-05 custom "envelope" "allocate" "A" 100.00 USD
2024-01-06 custom "envelope" "allocate" "A" -30.00 USD
2024-01-06 custom "envelope" "allocate" "B" 30.00 USD
2024-01-07 custom "envelope" "close" "C"
2024-01-08 custom "envelope" "allocate" "A" 10.00 USD
2024-01-09 custom "envelope" "allocate" "Ghost" 5.00 USD
2024-01-10 custom "envelope" "open" "A"
2024-01-20 custom "envelope" "close" "B"
2024-01-21 custom "envelope" "allocate" "B" 5.00 USD

2024-02-01 custom "envelope" "plan" "A"
  monthly: 200.00
  priority: 2
