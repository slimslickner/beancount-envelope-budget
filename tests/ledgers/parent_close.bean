option "operating_currency" "USD"

; Two parents: "Living" keeps Rent open after Groceries closes, while "Gone"
; closes both its members, so its heading disappears once nothing is left.
2020-01-01 open Assets:Checking USD
  on-budget: TRUE
2020-01-01 open Expenses:Grocery USD
  envelope: "Groceries"
2020-01-01 open Expenses:Rent USD
  envelope: "Rent"
2020-01-01 open Expenses:Fun USD
  envelope: "Fun"
2020-01-01 open Expenses:Old USD
  envelope: "Old"
2020-01-01 open Equity:Opening-Balances USD

2023-12-31 * "Opening balance"
  Assets:Checking            10000.00 USD
  Equity:Opening-Balances   -10000.00 USD

2024-01-01 custom "envelope" "start"
2024-01-01 custom "envelope" "open" "Groceries"
  parent: "Living"
2024-01-01 custom "envelope" "open" "Rent"
  parent: "Living"
2024-01-01 custom "envelope" "open" "Fun"
  parent: "Gone"
2024-01-01 custom "envelope" "open" "Old"
  parent: "Gone"

2024-01-01 custom "envelope" "allocate" "Groceries" 100.00 USD
2024-01-01 custom "envelope" "allocate" "Rent" 200.00 USD
2024-01-01 custom "envelope" "allocate" "Fun" 50.00 USD
2024-01-01 custom "envelope" "allocate" "Old" 50.00 USD

; Groceries, Fun and Old spend to zero and close; Rent stays open.
2024-01-05 * "Groceries"
  Expenses:Grocery           100.00 USD
  Assets:Checking           -100.00 USD
2024-01-06 * "Fun"
  Expenses:Fun                50.00 USD
  Assets:Checking            -50.00 USD
2024-01-07 * "Old"
  Expenses:Old                50.00 USD
  Assets:Checking            -50.00 USD

2024-02-07 custom "envelope" "close" "Groceries"
2024-02-07 custom "envelope" "close" "Fun"
2024-02-07 custom "envelope" "close" "Old"
