option "operating_currency" "USD"

; A hand-sized budget that shows every feature in one place. It is
; generated by scripts/sample_ledger.py; regenerate it after a change.

; --- Accounts ------------------------------------------------

2023-12-01 open Assets:Checking USD
  cash-account: TRUE
2023-12-01 open Assets:Savings USD
  cash-account: TRUE
2023-12-01 open Liabilities:CreditCard USD
  cash-account: TRUE
2023-12-01 open Assets:Brokerage:Cash USD
  cash-account: TRUE
2023-12-01 open Assets:Brokerage:VTI VTI
  envelope: "Investments"
2023-12-01 open Income:Salary USD
2023-12-01 open Income:Bonus USD
  envelope: "Bonus"
2023-12-01 open Equity:Opening-Balances USD
2023-12-01 open Expenses:Groceries USD
  envelope: "Groceries"
2023-12-01 open Expenses:Rent USD
  envelope: "Rent"
2023-12-01 open Expenses:Utilities USD
  envelope: "Utilities"
2023-12-01 open Expenses:Dining USD
  envelope: "Dining"
2023-12-01 open Expenses:Emergency USD
  envelope: "Emergency"
2023-12-01 open Expenses:Vacation USD
  envelope: "Vacation"
2023-12-01 open Expenses:Laptop USD
  envelope: "Laptop"
2023-12-01 open Expenses:Moving USD
  envelope: "Moving"
2023-12-01 open Expenses:Gym USD
  envelope: "Gym"
2023-12-01 open Expenses:Subscriptions USD
  envelope: "Subscriptions"
2023-12-01 open Expenses:Gifts USD
  envelope: "Gifts"
2023-12-01 open Expenses:Fun USD
  envelope: "Fun"
2023-12-01 open Expenses:Costco USD
  envelope: "Groceries"
2023-12-01 open Expenses:Misc USD
  envelope: "pool"

; --- Pre-start history: the pool opens non-zero ---------------

2023-12-31 * "Opening balances"
  Assets:Checking 5000.00 USD
  Assets:Savings 20000.00 USD
  Equity:Opening-Balances -25000.00 USD

2024-01-01 custom "envelope" "start"

; --- Envelope declarations ------------------------------------

2024-01-01 custom "envelope" "open" "Groceries"
2024-01-01 custom "envelope" "open" "Dining"
  monthly: "avg3"
2024-01-01 custom "envelope" "open" "Rent"
  monthly: 2000.00
  parent: "Home"
2024-01-01 custom "envelope" "open" "Utilities"
  monthly: 200.00
  up-to: 600.00
  parent: "Home"
2024-01-01 custom "envelope" "open" "Emergency"
  goal: 6000.00 USD
  by: 2024-12-31
2024-01-01 custom "envelope" "open" "Vacation"
  goal: 3000.00 USD
  by: 2024-06-30
2024-01-01 custom "envelope" "open" "Laptop"
  goal: 1500.00 USD
  by: 2024-05-31
2024-01-01 custom "envelope" "open" "Moving"
2024-01-01 custom "envelope" "open" "Subscriptions"
  monthly: 30.00
2024-01-01 custom "envelope" "open" "Gifts"
2024-01-01 custom "envelope" "open" "Fun"
2024-01-01 custom "envelope" "open" "Bonus"
2024-01-01 custom "envelope" "open" "Investments"

; An envelope opened partway through is hidden before its open month.
2024-03-01 custom "envelope" "open" "Gym"
  monthly: 50.00

