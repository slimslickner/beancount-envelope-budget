option "operating_currency" "USD"

2020-01-01 open Assets:Checking USD
  cash-account: TRUE
2020-01-01 open Equity:Opening-Balances USD

2023-12-31 * "Opening balance"
  Assets:Checking            3000.00 USD
  Equity:Opening-Balances   -3000.00 USD

