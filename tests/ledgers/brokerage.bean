option "operating_currency" "USD"

; A brokerage: cash is on-budget, the security is off-budget but enveloped, so
; buys and sells move money between the "Taxable Investments" goal and cash.
2020-01-01 open Assets:Brokerage:Cash USD
  cash-account: TRUE
2020-01-01 open Assets:Brokerage:VTI VTI
  envelope: "Taxable Investments"
2020-01-01 open Equity:Opening-Balances USD

2025-12-31 * "Opening balance"
  Assets:Brokerage:Cash   5000.00 USD
  Equity:Opening-Balances -5000.00 USD

; Before the start date, but it still sets the opening cash (valued at cost).
2025-12-31 * "Pre-start buy"
  Assets:Brokerage:VTI           1 VTI {100.00 USD}
  Assets:Brokerage:Cash   -100.00 USD

2026-01-01 custom "envelope" "start"
2026-01-01 custom "envelope" "open" "Taxable Investments"
2026-01-01 custom "envelope" "allocate" "Taxable Investments" 2000.00 USD

2026-01-05 * "Buy VTI at cost"
  Assets:Brokerage:VTI           5 VTI {200.00 USD}
  Assets:Brokerage:Cash  -1000.00 USD

2026-01-15 * "Buy VTI at price"
  Assets:Brokerage:VTI      2 VTI @ 210.00 USD
  Assets:Brokerage:Cash   -420.00 USD

2026-01-20 * "Sell with gain"
  Assets:Brokerage:VTI          -5 VTI {200.00 USD}
  Assets:Brokerage:Cash   1100.00 USD
  Equity:Opening-Balances -100.00 USD
