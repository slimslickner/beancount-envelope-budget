option "operating_currency" "USD"

2020-01-01 open Assets:Checking USD
  cash-account: TRUE
2020-01-01 open Assets:401k USD
  envelope: "Retirement"
2020-01-01 open Equity:Opening-Balances USD

2023-12-31 * "Opening balance"
  Assets:Checking            1000.00 USD
  Equity:Opening-Balances   -1000.00 USD

2024-01-01 custom "envelope" "start"
2024-01-01 custom "envelope" "open" "Retirement"

2024-01-10 * "Contribute to retirement"
  Assets:401k        500.00 USD
  Assets:Checking   -500.00 USD

2024-02-10 * "Withdraw from retirement"
  Assets:Checking    200.00 USD
  Assets:401k       -200.00 USD
