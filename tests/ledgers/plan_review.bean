  envelope: "Repairs"
2020-01-01 open Expenses:Gifts USD
  envelope: "Gifts"
2020-01-01 open Expenses:Fun USD
  envelope: "Fun"

2023-12-31 * "Opening balance"
  Assets:Checking            5000.00 USD
  Equity:Opening-Balances   -5000.00 USD

2024-01-01 custom "envelope" "start"
2024-01-01 custom "envelope" "open" "Groceries"
  parent: "Home"
  monthly: 500.00
2024-01-01 custom "envelope" "open" "Insurance"
  parent: "Home"
  monthly: 100.00
  up-to: 300.00
2024-01-01 custom "envelope" "open" "Car"
  parent: "Transport"
  monthly: 200.00
2024-01-01 custom "envelope" "open" "Repairs"
  parent: "Transport"
  monthly: 100.00
  up-to: 1200.00
2024-01-01 custom "envelope" "open" "Gifts"
  monthly: 100.00
  up-to: 1200.00
2024-01-01 custom "envelope" "open" "Fun"
2024-01-01 custom "envelope" "open" "Vacation"
  goal: 6000.00 USD
  by: 2025-06-01

